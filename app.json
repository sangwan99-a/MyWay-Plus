{
  "expo": {
    "name": "MyWay+",
    "slug": "myway-plus",
    "scheme": "mywayplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahilsangwan.mywayplus"
    },
    "android": {
      "package": "com.sahilsangwan.mywayplus",
      "edgeToEdgeEnabled": true
    },
    "web": { "bundler": "metro", "output": "static" }
  }
}